import AT.Regular.Defs

/-!
# Effective categorical closure of the regular fragment (paper §5.3, Theorem 5.3)

Finite limits, finite colimits and exponentials of `RegTS_E`, with the explicit heaps:
* products, equalizers (inverse images + intersection),
* coproducts, coequalizers (direct images + union),
* exponential `H_{B^A} = F_E(C) \ Bad_{A,B}` (eqs. 5.2–5.4),
* **Example 5.4** (parity condition on function records),
* the zero-ary fact clause `H_{B^A} ∩ E^* = {w : w ∈ H_A → w ∈ H_B}`.
-/

universe u v

namespace AT

open CategoryTheory Limits MonoidalCategory

variable {E : Type v}

/-! ### Regular-language closure facts used throughout -/

/-- Direct images of regular languages under letter maps are regular (NFA construction). -/
theorem Language.IsRegular.image_listMap {α β : Type*} (g : α → β) {L : Language α}
    (hL : L.IsRegular) : (show Language β from List.map g '' L).IsRegular := by
  obtain ⟨σ, _, M, hM⟩ := hL
  let N : NFA β σ :=
    { step := fun s b => {t | ∃ a, g a = b ∧ M.step s a = t}
      start := {M.start}
      accept := M.accept }
  have key : ∀ (w : List β) (S : Set σ) (t : σ),
      t ∈ N.evalFrom S w ↔ ∃ s ∈ S, ∃ x : List α, x.map g = w ∧ M.evalFrom s x = t := by
    intro w
    induction w with
    | nil =>
      intro S t
      simp only [NFA.evalFrom_nil, List.map_eq_nil_iff]
      constructor
      · intro h; exact ⟨t, h, [], rfl, rfl⟩
      · rintro ⟨s, hs, x, rfl, rfl⟩; exact hs
    | cons b w ih =>
      intro S t
      rw [NFA.evalFrom_cons, ih]
      constructor
      · rintro ⟨s', hs', x, hx, rfl⟩
        rw [NFA.mem_stepSet] at hs'
        obtain ⟨s, hs, a, rfl, rfl⟩ := hs'
        exact ⟨s, hs, a :: x, by simp [hx], rfl⟩
      · rintro ⟨s, hs, x, hx, rfl⟩
        cases x with
        | nil => simp at hx
        | cons a x =>
          simp only [List.map_cons, List.cons.injEq] at hx
          obtain ⟨rfl, rfl⟩ := hx
          exact ⟨M.step s a, NFA.mem_stepSet.2 ⟨s, hs, a, rfl, rfl⟩, x, rfl, rfl⟩
  refine ⟨Set σ, inferInstance, N.toDFA, ?_⟩
  rw [NFA.toDFA_correct, ← hM]
  ext w
  simp only [NFA.mem_accepts]
  constructor
  · rintro ⟨t, ht, hw⟩
    obtain ⟨s, hs, x, rfl, rfl⟩ := (key w _ t).1 hw
    obtain rfl : s = M.start := hs
    exact ⟨x, ht, rfl⟩
  · rintro ⟨x, hx, rfl⟩
    exact ⟨_, hx, (key _ _ _).2 ⟨M.start, rfl, x, rfl, rfl⟩⟩

theorem Language.IsRegular.comap_wordMap {A B : Type u} (f : A → B) {K : Language (B ⊕ E)}
    (hK : K.IsRegular) : (show Language (A ⊕ E) from wordMap f ⁻¹' K).IsRegular := by
  obtain ⟨σ, _, M, hM⟩ := hK
  exact ⟨σ, inferInstance, M.comap (Sum.map f id), by rw [DFA.accepts_comap, hM]; rfl⟩

theorem Language.IsRegular.image_wordMap {A B : Type u} [Finite A] (f : A → B) {H : Language (A ⊕ E)}
    (hH : H.IsRegular) : (show Language (B ⊕ E) from wordMap f '' H).IsRegular :=
  Language.IsRegular.image_listMap (Sum.map f id) hH

/-! ### Finite limits -/

theorem TokenClass.terminal_isRegular : (TokenClass.terminal.{u} E).IsRegularHeap :=
  ⟨Unit, inferInstance, ⟨fun _ _ => (), (), Set.univ⟩, by
    ext w; exact ⟨fun _ => Set.mem_univ _, fun _ => Set.mem_univ _⟩⟩

theorem TokenClass.prod_isRegular {T₁ T₂ : TokenClass.{u} E} [Finite T₁.carrier] [Finite T₂.carrier]
    (h₁ : T₁.IsRegularHeap) (h₂ : T₂.IsRegularHeap) : (T₁.prod T₂).IsRegularHeap :=
  (Language.IsRegular.comap_wordMap (E := E) Prod.fst h₁).inf
    (Language.IsRegular.comap_wordMap Prod.snd h₂)

theorem TokenClass.equalizer_isRegular {T₁ T₂ : TokenClass.{u} E} (f g : T₁ ⟶ T₂)
    (h₁ : T₁.IsRegularHeap) : (TokenClass.equalizer f g).IsRegularHeap :=
  Language.IsRegular.comap_wordMap Subtype.val h₁

/-! ### Finite colimits -/

/-- The initial object: empty carrier, empty heap. -/
def TokenClass.initial (E : Type v) : TokenClass.{u} E := ⟨PEmpty, ∅⟩

/-- Binary coproduct: carrier `A ⊔ B`, heap `F_E(ι_A)(H_A) ∪ F_E(ι_B)(H_B)`. -/
def TokenClass.coprod (T₁ T₂ : TokenClass.{u} E) : TokenClass.{u} E where
  carrier := T₁.carrier ⊕ T₂.carrier
  heap := wordMap Sum.inl '' T₁.heap ∪ wordMap Sum.inr '' T₂.heap

/-- Coequalizer of `f, g`: the quotient by the equivalence relation generated by
`(f a, g a)`, with heap `F_E(q)(H_B)`. -/
def TokenClass.coequalizer {T₁ T₂ : TokenClass.{u} E} (f g : T₁ ⟶ T₂) : TokenClass.{u} E where
  carrier := Quot (fun b b' : T₂.carrier => ∃ a, f.toFun a = b ∧ g.toFun a = b')
  heap := wordMap (Quot.mk _) '' T₂.heap

/-- `TokenClass.initial` is initial. -/
def TokenClass.initialIsInitial : IsInitial (TokenClass.initial.{u} E) :=
  IsInitial.ofUniqueHom (fun _ => ⟨PEmpty.elim, fun _ hw => absurd hw (Set.notMem_empty _)⟩)
    (fun _ _ => TokenClass.Hom.ext (funext fun x => x.elim))

/-- The coproduct cocone for `TokenClass.coprod`. -/
def TokenClass.coprodCofan (T₁ T₂ : TokenClass.{u} E) : BinaryCofan T₁ T₂ :=
  BinaryCofan.mk (P := T₁.coprod T₂)
    ⟨Sum.inl, fun w hw => Or.inl ⟨w, hw, rfl⟩⟩ ⟨Sum.inr, fun w hw => Or.inr ⟨w, hw, rfl⟩⟩

/-- `TokenClass.coprod` is a categorical coproduct. -/
def TokenClass.coprodIsColimit (T₁ T₂ : TokenClass.{u} E) : IsColimit (T₁.coprodCofan T₂) :=
  BinaryCofan.isColimitMk
    (fun c => ⟨Sum.elim c.inl.toFun c.inr.toFun, fun w hw => by
      rcases hw with ⟨v, hv, rfl⟩ | ⟨v, hv, rfl⟩
      · show (wordMap (Sum.elim c.inl.toFun c.inr.toFun) ∘ wordMap Sum.inl) v ∈ _
        rw [← wordMap_comp, Sum.elim_comp_inl]; exact c.inl.preserves v hv
      · show (wordMap (Sum.elim c.inl.toFun c.inr.toFun) ∘ wordMap Sum.inr) v ∈ _
        rw [← wordMap_comp, Sum.elim_comp_inr]; exact c.inr.preserves v hv⟩)
    (fun _ => rfl) (fun _ => rfl)
    (fun c m h₁ h₂ => by
      apply TokenClass.Hom.ext; funext x
      rcases x with x | x
      · exact congrArg (fun k : Hom _ _ => k.toFun x) h₁
      · exact congrArg (fun k : Hom _ _ => k.toFun x) h₂)

/-- The coequalizer cofork. -/
def TokenClass.coequalizerCofork {T₁ T₂ : TokenClass.{u} E} (f g : T₁ ⟶ T₂) : Cofork f g :=
  Cofork.ofπ (P := TokenClass.coequalizer f g) ⟨Quot.mk _, fun w hw => ⟨w, hw, rfl⟩⟩
    (TokenClass.Hom.ext (funext fun a => Quot.sound ⟨a, rfl, rfl⟩))

/-- `TokenClass.coequalizer` is a categorical coequalizer. -/
def TokenClass.coequalizerIsColimit {T₁ T₂ : TokenClass.{u} E} (f g : T₁ ⟶ T₂) :
    IsColimit (TokenClass.coequalizerCofork f g) :=
  Cofork.IsColimit.mk _
    (fun c => ⟨Quot.lift c.π.toFun (fun b b' h => by
        obtain ⟨a, rfl, rfl⟩ := h
        exact congrArg (fun k : Hom _ _ => k.toFun a) c.condition),
      fun w hw => by
        obtain ⟨v, hv, rfl⟩ := hw
        show (wordMap (Quot.lift c.π.toFun _) ∘ wordMap (Quot.mk _)) v ∈ _
        rw [← wordMap_comp]; exact c.π.preserves v hv⟩)
    (fun _ => rfl)
    (fun c m h => by
      apply TokenClass.Hom.ext; funext x
      induction x using Quot.ind with
      | _ b => exact congrArg (fun k : Hom _ _ => k.toFun b) h)

instance : HasInitial (TokenClass.{u} E) := IsInitial.hasInitial TokenClass.initialIsInitial

instance (T₁ T₂ : TokenClass.{u} E) : HasColimit (pair T₁ T₂) :=
  ⟨⟨⟨_, T₁.coprodIsColimit T₂⟩⟩⟩

instance : HasBinaryCoproducts (TokenClass.{u} E) := hasBinaryCoproducts_of_hasColimit_pair _

instance {T₁ T₂ : TokenClass.{u} E} (f g : T₁ ⟶ T₂) : HasColimit (parallelPair f g) :=
  ⟨⟨⟨_, TokenClass.coequalizerIsColimit f g⟩⟩⟩

instance : HasCoequalizers (TokenClass.{u} E) := hasCoequalizers_of_hasColimit_parallelPair _

instance : HasFiniteCoproducts (TokenClass.{u} E) := hasFiniteCoproducts_of_has_binary_and_initial

instance : HasFiniteColimits (TokenClass.{u} E) :=
  hasFiniteColimits_of_hasCoequalizers_and_finite_coproducts

theorem TokenClass.coprod_isRegular {T₁ T₂ : TokenClass.{u} E} [Finite T₁.carrier] [Finite T₂.carrier]
    (h₁ : T₁.IsRegularHeap) (h₂ : T₂.IsRegularHeap) : (T₁.coprod T₂).IsRegularHeap :=
  (Language.IsRegular.image_wordMap (E := E) Sum.inl h₁).add
    (Language.IsRegular.image_wordMap Sum.inr h₂)

theorem TokenClass.coequalizer_isRegular {T₁ T₂ : TokenClass.{u} E} [Finite T₂.carrier]
    (f g : T₁ ⟶ T₂) (h₂ : T₂.IsRegularHeap) : (TokenClass.coequalizer f g).IsRegularHeap :=
  Language.IsRegular.image_wordMap (Quot.mk _) h₂

/-! ### Synchronized words over a pair alphabet -/

section pairs
variable {A B C : Type u}

@[simp] lemma wordMap_wordMap (f : A → B) (g : B → C) (w : Word A E) :
    wordMap g (wordMap f w) = wordMap (g ∘ f) w :=
  (congrFun (wordMap_comp f g) w).symm

/-- A word over a pair alphabet is determined by its two projections. -/
lemma wordMap_prod_ext {u v : Word (A × B) E}
    (h₁ : wordMap Prod.fst u = wordMap Prod.fst v)
    (h₂ : wordMap Prod.snd u = wordMap Prod.snd v) : u = v := by
  induction u generalizing v with
  | nil => cases v with
    | nil => rfl
    | cons y v => simp at h₁
  | cons x u ih =>
    cases v with
    | nil => simp at h₁
    | cons y v =>
      simp only [wordMap_cons, List.cons.injEq] at h₁ h₂
      rw [ih h₁.2 h₂.2]
      rcases x with ⟨a, b⟩ | e <;> rcases y with ⟨a', b'⟩ | e' <;> simp_all

/-- Two words with a common image under letter maps can be synchronized into a word over the
pair alphabet. -/
lemma exists_zip (h : A → C) (k : B → C) {w : Word A E} {v : Word B E}
    (e : wordMap h w = wordMap k v) :
    ∃ u : Word (A × B) E, wordMap Prod.fst u = w ∧ wordMap Prod.snd u = v := by
  induction w generalizing v with
  | nil => cases v with
    | nil => exact ⟨[], rfl, rfl⟩
    | cons y v => simp at e
  | cons x w ih =>
    cases v with
    | nil => simp at e
    | cons y v =>
      simp only [wordMap_cons, List.cons.injEq] at e
      obtain ⟨u, hu₁, hu₂⟩ := ih e.2
      rcases x with a | e₁ <;> rcases y with b | e₂
      · exact ⟨Sum.inl (a, b) :: u, by simp [hu₁], by simp [hu₂]⟩
      · simp at e
      · simp at e
      · obtain rfl : e₁ = e₂ := by simpa using e.1
        exact ⟨Sum.inr e₁ :: u, by simp [hu₁], by simp [hu₂]⟩

lemma coreOnly_wordMap_iff (f : A → B) (w : Word A E) : CoreOnly (wordMap f w) ↔ CoreOnly w := by
  simp [CoreOnly, wordMap]

/-- A core-only word is determined by its image under any letter map. -/
lemma CoreOnly.eq_of_wordMap_eq {w v : Word A E} (hw : CoreOnly w) (f g : A → B)
    (h : wordMap f w = wordMap g v) : w = v := by
  induction w generalizing v with
  | nil => cases v with
    | nil => rfl
    | cons y v => simp at h
  | cons x w ih =>
    cases v with
    | nil => simp at h
    | cons y v =>
      simp only [wordMap_cons, List.cons.injEq] at h
      have hx := hw x (List.mem_cons_self ..)
      rw [ih (fun z hz => hw z (List.mem_cons_of_mem _ hz)) h.2]
      rcases x with a | e <;> rcases y with b | e'
      · simp at hx
      · simp at hx
      · simp at h
      · obtain rfl : e = e' := by simpa using h.1
        rfl

end pairs

/-! ### Exponentials (eqs. 5.2–5.4) -/

section exponential
variable (T₁ T₂ : TokenClass.{u} E)

/-- `C = B^A`, all carrier functions. -/
abbrev TokenClass.expCarrier := T₁.carrier → T₂.carrier

/-- `W_{A,B} = F_E(q)⁻¹(H_A) ∩ F_E(e)⁻¹(F_E(B) \ H_B)`: failing synchronized records
over the pair alphabet `(C × A) ⊔ E`. -/
def TokenClass.badPairs : Set (Word (TokenClass.expCarrier T₁ T₂ × T₁.carrier) E) :=
  {w | wordMap Prod.snd w ∈ T₁.heap ∧ wordMap (fun p => p.1 p.2) w ∉ T₂.heap}

/-- `Bad_{A,B} = F_E(p)(W_{A,B})`. -/
def TokenClass.badWords : Set (Word (TokenClass.expCarrier T₁ T₂) E) :=
  wordMap Prod.fst '' TokenClass.badPairs T₁ T₂

/-- The exponential `T_B^{T_A}` with heap `F_E(C) \ Bad_{A,B}`. -/
def TokenClass.exp : TokenClass.{u} E where
  carrier := TokenClass.expCarrier T₁ T₂
  heap := (TokenClass.badWords T₁ T₂)ᶜ

variable {T₁ T₂} in
/-- The defining property of the exponential heap: a function record is present iff every
synchronized source record in `H_A` evaluates into `H_B`. -/
theorem TokenClass.mem_exp_heap_iff (w : Word (TokenClass.expCarrier T₁ T₂) E) :
    w ∈ (TokenClass.exp T₁ T₂).heap ↔
      ∀ u : Word (TokenClass.expCarrier T₁ T₂ × T₁.carrier) E, wordMap Prod.fst u = w →
        wordMap Prod.snd u ∈ T₁.heap → wordMap (fun p => p.1 p.2) u ∈ T₂.heap := by
  show w ∉ TokenClass.badWords T₁ T₂ ↔ _
  simp only [TokenClass.badWords, TokenClass.badPairs, Set.mem_image, Set.mem_ofPred_eq, not_exists,
    not_and]
  constructor
  · intro h u hu h₁
    by_contra h₂
    exact h u ⟨h₁, h₂⟩ hu
  · rintro h u ⟨h₁, h₂⟩ hu
    exact h₂ (h u hu h₁)

/-- Evaluation `e : C × A → B` is a Token map `T_B^{T_A} × T_A → T_B`. -/
def TokenClass.eval : (TokenClass.exp T₁ T₂).prod T₁ ⟶ T₂ :=
  ⟨fun p => p.1 p.2, fun w hw => (TokenClass.mem_exp_heap_iff _).1 hw.1 w rfl hw.2⟩

/-- Currying: a Token map `Z × T_A → T_B` gives `Z → T_B^{T_A}`. -/
def TokenClass.curry {Z : TokenClass.{u} E} (g : Z.prod T₁ ⟶ T₂) : Z ⟶ TokenClass.exp T₁ T₂ :=
  ⟨fun d a => g.toFun (d, a), fun w hw => by
    refine (TokenClass.mem_exp_heap_iff _).2 fun u hu h₁ => ?_
    let ĝ : Z.carrier → TokenClass.expCarrier T₁ T₂ := fun d a => g.toFun (d, a)
    let cZ : Z.carrier → PUnit.{u+1} := fun _ => PUnit.unit
    let cC : TokenClass.expCarrier T₁ T₂ → PUnit.{u+1} := fun _ => PUnit.unit
    let cA : T₁.carrier → PUnit.{u+1} := fun _ => PUnit.unit
    -- synchronize `w` with the source record `wordMap Prod.snd u`
    have hsh : wordMap cZ w = wordMap cA (wordMap Prod.snd u) :=
      calc wordMap cZ w = wordMap cC (wordMap ĝ w) := (wordMap_wordMap ĝ cC w).symm
        _ = wordMap cC (wordMap Prod.fst u) := congrArg (wordMap cC) hu.symm
        _ = wordMap cA (wordMap Prod.snd u) :=
              (wordMap_wordMap Prod.fst cC u).trans (wordMap_wordMap Prod.snd cA u).symm
    obtain ⟨u', hu'₁, hu'₂⟩ := exists_zip (E := E) cZ cA hsh
    let m : Z.carrier × T₁.carrier → TokenClass.expCarrier T₁ T₂ × T₁.carrier :=
      fun p => (ĝ p.1, p.2)
    have hu' : wordMap m u' = u := by
      apply wordMap_prod_ext
      · calc wordMap Prod.fst (wordMap m u') = wordMap ĝ (wordMap Prod.fst u') :=
              (wordMap_wordMap m Prod.fst u').trans (wordMap_wordMap Prod.fst ĝ u').symm
          _ = wordMap Prod.fst u := by rw [hu'₁]; exact hu.symm
      · exact (wordMap_wordMap m Prod.snd u').trans hu'₂
    have hev : wordMap (fun p : TokenClass.expCarrier T₁ T₂ × T₁.carrier => p.1 p.2) u =
        wordMap g.toFun u' := by
      rw [← hu']; exact wordMap_wordMap m _ u'
    rw [hev]
    exact g.preserves u' ⟨by rwa [hu'₁], by rwa [hu'₂]⟩⟩

/-- Uncurrying: a Token map `Z → T_B^{T_A}` gives `Z × T_A → T_B`. -/
def TokenClass.uncurry {Z : TokenClass.{u} E} (g : Z ⟶ TokenClass.exp T₁ T₂) : Z.prod T₁ ⟶ T₂ :=
  ⟨fun p => g.toFun p.1 p.2, fun w hw => by
    have h₁ := (TokenClass.mem_exp_heap_iff _).1 (g.preserves _ hw.1)
    let m : Z.carrier × T₁.carrier → TokenClass.expCarrier T₁ T₂ × T₁.carrier :=
      fun p => (g.toFun p.1, p.2)
    have := h₁ (wordMap m w)
      ((wordMap_wordMap m Prod.fst w).trans (wordMap_wordMap Prod.fst g.toFun w).symm)
      (Set.mem_of_eq_of_mem (wordMap_wordMap m Prod.snd w) hw.2)
    exact Set.mem_of_eq_of_mem
      (wordMap_wordMap m (fun p : TokenClass.expCarrier T₁ T₂ × T₁.carrier => p.1 p.2) w).symm this⟩

/-- The natural bijection `Hom(Z × T_A, T_B) ≅ Hom(Z, T_B^{T_A})`. -/
def TokenClass.curryEquiv (Z : TokenClass.{u} E) :
    (Z.prod T₁ ⟶ T₂) ≃ (Z ⟶ TokenClass.exp T₁ T₂) where
  toFun := TokenClass.curry T₁ T₂
  invFun := TokenClass.uncurry T₁ T₂
  left_inv _ := rfl
  right_inv _ := rfl

/-- The zero-ary fact clause: `H_{B^A} ∩ E^* = {w ∈ E^* : w ∈ H_A → w ∈ H_B}`. -/
theorem TokenClass.exp_coreOnly (w : Word (TokenClass.expCarrier T₁ T₂) E) (hw : CoreOnly w) :
    w ∈ (TokenClass.exp T₁ T₂).heap ↔
      (wordMap (fun _ => PUnit.unit) w ∈ wordMap (E := E) (fun _ : T₁.carrier => PUnit.unit) '' T₁.heap →
        wordMap (fun _ => PUnit.unit) w ∈ wordMap (fun _ : T₂.carrier => PUnit.unit) '' T₂.heap) := by
  rw [TokenClass.mem_exp_heap_iff]
  constructor
  · rintro h ⟨v, hv, hvw⟩
    obtain ⟨u, hu₁, hu₂⟩ := exists_zip (E := E) (fun _ : TokenClass.expCarrier T₁ T₂ => PUnit.unit)
      (fun _ : T₁.carrier => PUnit.unit) hvw.symm
    refine ⟨_, h u hu₁ (hu₂ ▸ hv), ?_⟩
    rw [← Function.comp_apply (f := wordMap _), ← wordMap_comp, ← hu₁,
      ← Function.comp_apply (f := wordMap _), ← wordMap_comp]
    rfl
  · intro h u hu h₁
    obtain ⟨v, hv, hvw⟩ := h ⟨_, h₁, by
      rw [← Function.comp_apply (f := wordMap _), ← wordMap_comp, ← hu,
        ← Function.comp_apply (f := wordMap _), ← wordMap_comp]; rfl⟩
    have hu' : CoreOnly u := (coreOnly_wordMap_iff Prod.fst u).1 (hu ▸ hw)
    have hcore : CoreOnly (wordMap (fun p : TokenClass.expCarrier T₁ T₂ × T₁.carrier => p.1 p.2) u) :=
      (coreOnly_wordMap_iff _ u).2 hu'
    have : wordMap (fun _ : T₂.carrier => PUnit.unit)
        (wordMap (fun p : TokenClass.expCarrier T₁ T₂ × T₁.carrier => p.1 p.2) u) =
        wordMap (fun _ : T₂.carrier => PUnit.unit) v := by
      rw [hvw, ← hu, ← Function.comp_apply (f := wordMap _), ← wordMap_comp,
        ← Function.comp_apply (f := wordMap _), ← wordMap_comp]; rfl
    rw [hcore.eq_of_wordMap_eq _ _ this]
    exact hv

theorem TokenClass.exp_isRegular [Finite T₁.carrier] [Finite T₂.carrier]
    (h₁ : T₁.IsRegularHeap) (h₂ : T₂.IsRegularHeap) : (TokenClass.exp T₁ T₂).IsRegularHeap := by
  have hbad : Language.IsRegular (show Language (TokenClass.expCarrier T₁ T₂ × T₁.carrier ⊕ E) from
      TokenClass.badPairs T₁ T₂) :=
    (Language.IsRegular.comap_wordMap (E := E) Prod.snd h₁).inf
      (Language.IsRegular.comap_wordMap
        (fun p : TokenClass.expCarrier T₁ T₂ × T₁.carrier => p.1 p.2) h₂.compl)
  exact (Language.IsRegular.image_wordMap (E := E) Prod.fst hbad).compl

end exponential

/-- `TS_E` is cartesian closed with the explicit exponential. -/
instance : CartesianMonoidalCategory (TokenClass.{u} E) :=
  CartesianMonoidalCategory.ofChosenFiniteProducts
    ⟨asEmptyCone (TokenClass.terminal E), TokenClass.terminalIsTerminal⟩
    (fun X Y => ⟨X.prodFan Y, X.prodIsLimit Y⟩)

@[simp] theorem TokenClass.tensorObj_eq (X Y : TokenClass.{u} E) : X ⊗ Y = X.prod Y := rfl

theorem TokenClass.whiskerLeft_toFun (X : TokenClass.{u} E) {Y Z : TokenClass.{u} E} (f : Y ⟶ Z)
    (p : (X.prod Y).carrier) : (X ◁ f).toFun p = (p.1, f.toFun p.2) := rfl

/-- The symmetry `X × Z → Z × X` as a Token map. -/
def TokenClass.swapHom (X Z : TokenClass.{u} E) : X.prod Z ⟶ Z.prod X :=
  ⟨Prod.swap, fun w hw =>
    ⟨Set.mem_of_eq_of_mem (wordMap_wordMap Prod.swap Prod.fst w) hw.2,
     Set.mem_of_eq_of_mem (wordMap_wordMap Prod.swap Prod.snd w) hw.1⟩⟩

/-- The bijection `Hom(X ⊗ Z, Y) ≃ Hom(Z, Y^X)` used to build the closed structure. -/
def TokenClass.closedEquiv (X Z Y : TokenClass.{u} E) : (X ⊗ Z ⟶ Y) ≃ (Z ⟶ TokenClass.exp X Y) where
  toFun g := TokenClass.curry X Y (TokenClass.swapHom Z X ≫ g)
  invFun h := TokenClass.swapHom X Z ≫ TokenClass.uncurry X Y h
  left_inv _ := TokenClass.Hom.ext (funext fun _ => rfl)
  right_inv _ := TokenClass.Hom.ext (funext fun _ => rfl)

theorem TokenClass.closedEquiv_natural (X : TokenClass.{u} E) :
    ∀ (Z' Z Y : TokenClass.{u} E) (f : Z' ⟶ Z) (g : X ⊗ Z ⟶ Y),
      TokenClass.closedEquiv X Z' Y ((tensorLeft X).map f ≫ g) =
        f ≫ TokenClass.closedEquiv X Z Y g :=
  fun _ _ _ _ _ => TokenClass.Hom.ext (funext fun _ => rfl)

instance : MonoidalClosed (TokenClass.{u} E) where
  closed X :=
    { rightAdj := Adjunction.rightAdjointOfEquiv (F := tensorLeft X) (TokenClass.closedEquiv X)
        (TokenClass.closedEquiv_natural X)
      adj := Adjunction.adjunctionOfEquivRight (F := tensorLeft X) (TokenClass.closedEquiv X)
        (TokenClass.closedEquiv_natural X) }

/-! ### Closure of `isRegTS` under isomorphisms and finite (co)limit shapes -/

section regClosure

/-- An isomorphism `e : X ≅ Y` in `TS_E` expresses `H_Y` as the inverse image of `H_X`. -/
theorem TokenClass.heap_eq_preimage_of_iso {X Y : TokenClass.{u} E} (e : X ≅ Y) :
    Y.heap = wordMap e.inv.toFun ⁻¹' X.heap := by
  ext w
  refine ⟨fun hw => e.inv.preserves w hw, fun hw => ?_⟩
  have := e.hom.preserves _ hw
  rwa [wordMap_wordMap, show e.hom.toFun ∘ e.inv.toFun = id from
    funext fun y => congrArg (fun k : TokenClass.Hom _ _ => k.toFun y) e.inv_hom_id, wordMap_id] at this

instance isRegTS.isClosedUnderIsomorphisms : (isRegTS.{u} E).IsClosedUnderIsomorphisms where
  of_iso {X Y} e hX := by
    obtain ⟨hfin, hreg⟩ := hX
    refine ⟨Finite.of_injective e.inv.toFun fun a b h => ?_, ?_⟩
    · have := congrArg e.hom.toFun h
      rwa [show ∀ y, e.hom.toFun (e.inv.toFun y) = y from
        fun y => congrArg (fun k : TokenClass.Hom _ _ => k.toFun y) e.inv_hom_id,
        show ∀ y, e.hom.toFun (e.inv.toFun y) = y from
        fun y => congrArg (fun k : TokenClass.Hom _ _ => k.toFun y) e.inv_hom_id] at this
    · show Y.lang.IsRegular
      have : Y.lang = (show Language (Y.carrier ⊕ E) from wordMap e.inv.toFun ⁻¹' X.heap) :=
        TokenClass.heap_eq_preimage_of_iso e
      rw [this]
      exact Language.IsRegular.comap_wordMap e.inv.toFun hreg

instance isRegTS.isClosedUnderLimitsOfShape_empty :
    (isRegTS.{u} E).IsClosedUnderLimitsOfShape (Discrete PEmpty.{1}) :=
  ObjectProperty.IsClosedUnderLimitsOfShape.mk' (by
    rintro _ ⟨F, hF⟩
    refine ObjectProperty.prop_of_iso _ (IsLimit.conePointsIsoOfNatIso
      TokenClass.terminalIsTerminal (limit.isLimit F) (Functor.uniqueFromEmpty F).symm) ?_
    exact ⟨inferInstanceAs (Finite PUnit), TokenClass.terminal_isRegular⟩)

instance isRegTS.isClosedUnderLimitsOfShape_pair :
    (isRegTS.{u} E).IsClosedUnderLimitsOfShape (Discrete WalkingPair) :=
  ObjectProperty.IsClosedUnderLimitsOfShape.mk' (by
    rintro _ ⟨F, hF⟩
    obtain ⟨h₁, h₁'⟩ := hF ⟨WalkingPair.left⟩
    obtain ⟨h₂, h₂'⟩ := hF ⟨WalkingPair.right⟩
    refine ObjectProperty.prop_of_iso _ (IsLimit.conePointsIsoOfNatIso
      (TokenClass.prodIsLimit _ _) (limit.isLimit F) (diagramIsoPair F).symm) ?_
    exact ⟨inferInstanceAs (Finite (_ × _)), TokenClass.prod_isRegular h₁' h₂'⟩)

instance isRegTS.isClosedUnderLimitsOfShape_parallelPair :
    (isRegTS.{u} E).IsClosedUnderLimitsOfShape WalkingParallelPair :=
  ObjectProperty.IsClosedUnderLimitsOfShape.mk' (by
    rintro _ ⟨F, hF⟩
    obtain ⟨h₁, h₁'⟩ := hF WalkingParallelPair.zero
    refine ObjectProperty.prop_of_iso _ (IsLimit.conePointsIsoOfNatIso
      (TokenClass.equalizerIsLimit _ _) (limit.isLimit F) (diagramIsoParallelPair F).symm) ?_
    exact ⟨inferInstanceAs (Finite (Subtype _)), TokenClass.equalizer_isRegular _ _ h₁'⟩)

instance isRegTS.isClosedUnderColimitsOfShape_empty :
    (isRegTS.{u} E).IsClosedUnderColimitsOfShape (Discrete PEmpty.{1}) :=
  ObjectProperty.IsClosedUnderColimitsOfShape.mk' (by
    rintro _ ⟨F, hF⟩
    refine ObjectProperty.prop_of_iso _ (IsColimit.coconePointsIsoOfNatIso
      TokenClass.initialIsInitial (colimit.isColimit F) (Functor.uniqueFromEmpty F).symm) ?_
    refine ⟨inferInstanceAs (Finite PEmpty), ?_⟩
    exact ⟨Unit, inferInstance, ⟨fun _ _ => (), (), ∅⟩, by
      ext w; simp only [DFA.mem_accepts, Set.notMem_empty, false_iff]; exact Set.notMem_empty w⟩)

instance isRegTS.isClosedUnderColimitsOfShape_pair :
    (isRegTS.{u} E).IsClosedUnderColimitsOfShape (Discrete WalkingPair) :=
  ObjectProperty.IsClosedUnderColimitsOfShape.mk' (by
    rintro _ ⟨F, hF⟩
    obtain ⟨h₁, h₁'⟩ := hF ⟨WalkingPair.left⟩
    obtain ⟨h₂, h₂'⟩ := hF ⟨WalkingPair.right⟩
    refine ObjectProperty.prop_of_iso _ (IsColimit.coconePointsIsoOfNatIso
      (TokenClass.coprodIsColimit _ _) (colimit.isColimit F) (diagramIsoPair F).symm) ?_
    exact ⟨inferInstanceAs (Finite (_ ⊕ _)), TokenClass.coprod_isRegular h₁' h₂'⟩)

instance isRegTS.isClosedUnderColimitsOfShape_parallelPair :
    (isRegTS.{u} E).IsClosedUnderColimitsOfShape WalkingParallelPair :=
  ObjectProperty.IsClosedUnderColimitsOfShape.mk' (by
    rintro _ ⟨F, hF⟩
    obtain ⟨h₂, h₂'⟩ := hF WalkingParallelPair.one
    refine ObjectProperty.prop_of_iso _ (IsColimit.coconePointsIsoOfNatIso
      (TokenClass.coequalizerIsColimit _ _) (colimit.isColimit F) (diagramIsoParallelPair F).symm) ?_
    exact ⟨inferInstanceAs (Finite (Quot _)), TokenClass.coequalizer_isRegular _ _ h₂'⟩)

instance : HasFiniteProducts (RegTS.{u} E) := hasFiniteProducts_of_has_binary_and_terminal
instance : HasFiniteLimits (RegTS.{u} E) := hasFiniteLimits_of_hasEqualizers_and_finite_products
instance : HasFiniteCoproducts (RegTS.{u} E) := hasFiniteCoproducts_of_has_binary_and_initial
instance : HasFiniteColimits (RegTS.{u} E) :=
  hasFiniteColimits_of_hasCoequalizers_and_finite_coproducts

instance : PreservesFiniteProducts (isRegTS.{u} E).ι :=
  PreservesFiniteProducts.of_preserves_binary_and_terminal _
instance : PreservesFiniteLimits (isRegTS.{u} E).ι :=
  preservesFiniteLimits_of_preservesEqualizers_and_finiteProducts _
instance : PreservesFiniteCoproducts (isRegTS.{u} E).ι :=
  ⟨fun n => PreservesFiniteCoproducts.of_preserves_binary_and_initial _ (Fin n)⟩
instance : PreservesFiniteColimits (isRegTS.{u} E).ι :=
  preservesFiniteColimits_of_preservesCoequalizers_and_finiteCoproducts _

end regClosure

/-- **Theorem 5.3** (effective categorical closure): `RegTS_E` inherits finite limits, finite
colimits and exponentials; in particular it is bicartesian closed. -/
theorem RegTS.hasFiniteLimits [Finite E] : HasFiniteLimits (RegTS.{u} E) := inferInstance
theorem RegTS.hasFiniteColimits [Finite E] : HasFiniteColimits (RegTS.{u} E) := inferInstance
section regClosed

/-- The terminal object of `RegTS_E`. -/
def RegTS.terminal : RegTS.{u} E :=
  ⟨TokenClass.terminal E, inferInstanceAs (Finite PUnit), TokenClass.terminal_isRegular⟩

/-- `RegTS.terminal` is terminal. -/
def RegTS.terminalIsTerminal : IsTerminal (RegTS.terminal.{u} (E := E)) :=
  IsTerminal.ofUniqueHom (fun _ => ObjectProperty.homMk ⟨fun _ => PUnit.unit, fun _ _ => trivial⟩)
    (fun _ _ => InducedCategory.hom_ext (TokenClass.Hom.ext (funext fun _ => rfl)))

/-- Binary products in `RegTS_E`, computed as in `TS_E`. -/
def RegTS.prod (X Y : RegTS.{u} E) : RegTS.{u} E :=
  ⟨X.obj.prod Y.obj, by
    have := X.property.1; have := Y.property.1
    exact ⟨inferInstanceAs (Finite (_ × _)), TokenClass.prod_isRegular X.property.2 Y.property.2⟩⟩

/-- The product cone in `RegTS_E`. -/
def RegTS.prodFan (X Y : RegTS.{u} E) : BinaryFan X Y :=
  BinaryFan.mk (P := RegTS.prod X Y)
    (ObjectProperty.homMk ⟨Prod.fst, fun _ h => h.1⟩) (ObjectProperty.homMk ⟨Prod.snd, fun _ h => h.2⟩)

/-- `RegTS.prod` is a categorical product. -/
def RegTS.prodIsLimit (X Y : RegTS.{u} E) : IsLimit (RegTS.prodFan X Y) :=
  BinaryFan.isLimitMk
    (fun c => ObjectProperty.homMk
      ((X.obj.prodIsLimit Y.obj).lift (BinaryFan.mk c.fst.hom c.snd.hom)))
    (fun _ => InducedCategory.hom_ext (TokenClass.Hom.ext (funext fun _ => rfl)))
    (fun _ => InducedCategory.hom_ext (TokenClass.Hom.ext (funext fun _ => rfl)))
    (fun c m h₁ h₂ => by
      apply InducedCategory.hom_ext; apply TokenClass.Hom.ext; funext x
      exact Prod.ext (congrArg (fun k : c.pt ⟶ X => k.hom.toFun x) h₁)
        (congrArg (fun k : c.pt ⟶ Y => k.hom.toFun x) h₂))

instance RegTS.cartesianMonoidalCategory : CartesianMonoidalCategory (RegTS.{u} E) :=
  CartesianMonoidalCategory.ofChosenFiniteProducts
    ⟨asEmptyCone RegTS.terminal, RegTS.terminalIsTerminal⟩
    (fun X Y => ⟨RegTS.prodFan X Y, RegTS.prodIsLimit X Y⟩)

/-- The exponential in `RegTS_E`, computed as in `TS_E` (regular by `exp_isRegular`). -/
def RegTS.exp (X Y : RegTS.{u} E) : RegTS.{u} E :=
  ⟨TokenClass.exp X.obj Y.obj, by
    have := X.property.1; have := Y.property.1
    exact ⟨inferInstanceAs (Finite (_ → _)), TokenClass.exp_isRegular _ _ X.property.2 Y.property.2⟩⟩

/-- The bijection `Hom(X ⊗ Z, Y) ≃ Hom(Z, Y^X)` in `RegTS_E`. -/
def RegTS.closedEquiv (X Z Y : RegTS.{u} E) : (X ⊗ Z ⟶ Y) ≃ (Z ⟶ RegTS.exp X Y) where
  toFun g := ObjectProperty.homMk (TokenClass.closedEquiv X.obj Z.obj Y.obj g.hom)
  invFun h := ObjectProperty.homMk ((TokenClass.closedEquiv X.obj Z.obj Y.obj).symm h.hom)
  left_inv _ := InducedCategory.hom_ext (TokenClass.Hom.ext (funext fun _ => rfl))
  right_inv _ := InducedCategory.hom_ext (TokenClass.Hom.ext (funext fun _ => rfl))

theorem RegTS.closedEquiv_natural (X : RegTS.{u} E) :
    ∀ (Z' Z Y : RegTS.{u} E) (f : Z' ⟶ Z) (g : X ⊗ Z ⟶ Y),
      RegTS.closedEquiv X Z' Y ((tensorLeft X).map f ≫ g) = f ≫ RegTS.closedEquiv X Z Y g :=
  fun _ _ _ _ _ => InducedCategory.hom_ext (TokenClass.Hom.ext (funext fun _ => rfl))

instance RegTS.monoidalClosed : MonoidalClosed (RegTS.{u} E) where
  closed X :=
    { rightAdj := Adjunction.rightAdjointOfEquiv (F := tensorLeft X) (RegTS.closedEquiv X)
        (RegTS.closedEquiv_natural X)
      adj := Adjunction.adjunctionOfEquivRight (F := tensorLeft X) (RegTS.closedEquiv X)
        (RegTS.closedEquiv_natural X) }

end regClosed

theorem RegTS.cartesianClosed [Finite E] :
    ∃ _ : CartesianMonoidalCategory (RegTS.{u} E), Nonempty (MonoidalClosed (RegTS.{u} E)) :=
  ⟨inferInstance, ⟨inferInstance⟩⟩

/-- The inclusion `RegTS_E → TS_E` preserves finite limits, finite colimits and exponentials. -/
theorem RegTS.ι_preservesFiniteLimits [Finite E] :
    Nonempty (PreservesFiniteLimits (isRegTS.{u} E).ι) := ⟨inferInstance⟩
theorem RegTS.ι_preservesFiniteColimits [Finite E] :
    Nonempty (PreservesFiniteColimits (isRegTS.{u} E).ι) := ⟨inferInstance⟩

/-! ### Example 5.4: a parity condition on function records -/

/-- `A = {a}`, `H_A = {a^{2m}}`. -/
def parityA : TokenClass.{0} PEmpty := ⟨Unit, {w | Even w.length}⟩

/-- `B = {0,1}`, `H_B` = binary words with an even number of `1`s. -/
def parityB : TokenClass.{0} PEmpty :=
  ⟨Bool, {w | Even (w.filter (fun x => x = Sum.inl true)).length}⟩

/-- Over the empty core alphabet with a one-point carrier, a word is determined by its length. -/
theorem word_unit_pempty (w : Word Unit PEmpty) : w = List.replicate w.length (Sum.inl ()) :=
  List.eq_replicate_iff.2 ⟨rfl, fun x _ => by
    cases x with
    | inl a => rfl
    | inr e => exact e.elim⟩

/-- A synchronized record over `C × {a}` is recovered from its `C`-projection. -/
theorem wordMap_pair_unit_fst {C : Type u} (u : Word (C × Unit) PEmpty) :
    wordMap (fun c => (c, ())) (wordMap Prod.fst u) = u := by
  rw [wordMap_wordMap]
  exact congrFun (wordMap_id (E := PEmpty) (A := C × Unit)) u

theorem parity_filter_length (w : Word (Unit → Bool) PEmpty) :
    ((wordMap (fun c : Unit → Bool => c ()) w).filter (fun x => x = Sum.inl true)).length =
      (w.filter (fun x => x = Sum.inl (fun _ => true))).length := by
  rw [wordMap, List.filter_map, List.length_map]
  congr 1
  apply List.filter_congr
  intro x _
  rcases x with c | e
  · simp only [Function.comp_apply, Sum.map_inl, Sum.inl.injEq, decide_eq_decide]
    exact ⟨fun h => funext fun _ => h, fun h => congrFun h ()⟩
  · exact e.elim

/-- **Example 5.4**: `H_{B^A} = {|w| odd} ∪ {|w| even ∧ |w|_{c₁} even}`. -/
theorem parity_exp_heap (w : Word (Unit → Bool) PEmpty) :
    w ∈ (TokenClass.exp parityA parityB).heap ↔
      Odd w.length ∨ (Even w.length ∧ Even (w.filter (fun x => x = Sum.inl (fun _ => true))).length) := by
  refine (TokenClass.mem_exp_heap_iff _).trans ?_
  show (∀ u : Word ((Unit → Bool) × Unit) PEmpty, wordMap Prod.fst u = w →
      Even (wordMap Prod.snd u).length →
      Even ((wordMap (fun p : (Unit → Bool) × Unit => p.1 p.2) u).filter
        (fun x => x = Sum.inl true)).length) ↔ _
  constructor
  · intro h
    rcases Nat.even_or_odd w.length with he | ho
    · refine Or.inr ⟨he, ?_⟩
      have := h (wordMap (fun c => (c, ())) w)
        (by rw [wordMap_wordMap]; exact congrFun (wordMap_id (E := PEmpty) (A := Unit → Bool)) w)
        (by rw [length_wordMap, length_wordMap]; exact he)
      rw [wordMap_wordMap] at this
      exact parity_filter_length w ▸ this
    · exact Or.inl ho
  · rintro h u hu hA
    have hu' : u = wordMap (fun c => (c, ())) w := by rw [← hu, wordMap_pair_unit_fst]
    subst hu'
    rw [length_wordMap, length_wordMap] at hA
    rcases h with ho | ⟨_, he⟩
    · exact absurd hA (Nat.not_even_iff_odd.2 ho)
    · rw [wordMap_wordMap]
      exact (parity_filter_length w).symm ▸ he

/-- Each constant function `c_j` is a Token map `T_A → T_B`, yet the mixed record
`(c₀, c₁)` is not in the exponential heap. -/
theorem parity_constants_are_maps (j : Bool) : TokenClass.IsHom parityA parityB (fun _ : Unit => j) := by
  intro w hw
  obtain ⟨n, rfl⟩ : ∃ n, w = List.replicate n (Sum.inl ()) := ⟨_, word_unit_pempty w⟩
  have hw' : Even n := by
    have : Even (List.replicate n (Sum.inl () : Unit ⊕ PEmpty)).length := hw
    rwa [List.length_replicate] at this
  show Even ((wordMap (fun _ : Unit => j) (List.replicate n (Sum.inl ()))).filter
    (fun x : Bool ⊕ PEmpty => decide (x = Sum.inl true))).length
  simp only [wordMap, List.map_replicate, Sum.map_inl, List.filter_replicate]
  cases j <;> simp [hw']

theorem parity_mixed_record_not_in_exp :
    ([Sum.inl (fun _ => false), Sum.inl (fun _ => true)] : Word (Unit → Bool) PEmpty) ∉
      (TokenClass.exp parityA parityB).heap := by
  rw [parity_exp_heap]
  simp [List.filter, funext_iff]

end AT
