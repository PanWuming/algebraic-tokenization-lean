import AT.Regular.Defs

/-!
# Nested terms as uniquely parsed words (paper §5.7) and the protocol format (§5.8)

* `AT.RankedTerm r A` — ordered terms over a ranked core with carrier leaves.
* `AT.RankedTerm.prefixWord` — prefix serialization `pre_A`.
* **Proposition 5.9**: `pre_A` is a bijection onto `W_{L_tree}(A)`, natural in leaf renaming.
* **Example 5.10**: the binary shape grammar is not regular.
* Closure of `Language.IsRegular` under finite languages, concatenation and Kleene star
  (`AT.isRegular_of_finite`, `AT.isRegular_mul`, `AT.isRegular_kstar`), via Myhill–Nerode.
-/

universe u v

namespace AT

open Computability

variable {E : Type v} (r : E → ℕ)

/-- Ordered terms whose leaves are carrier values and whose constructors are ranked labels. -/
inductive RankedTerm (A : Type u) : Type (max u v)
  | leaf : A → RankedTerm A
  | node : (ω : E) → (Fin (r ω) → RankedTerm A) → RankedTerm A

variable {r}

/-- Prefix serialization. -/
def RankedTerm.prefixWord {A : Type u} : RankedTerm r A → Word A E
  | .leaf a => [Sum.inl a]
  | .node ω ts => Sum.inr ω :: (List.ofFn fun i => (ts i).prefixWord).flatten

/-- Leaf renaming `T_E(f)`. -/
def RankedTerm.map {A B : Type u} (f : A → B) : RankedTerm r A → RankedTerm r B
  | .leaf a => .leaf (f a)
  | .node ω ts => .node ω fun i => (ts i).map f

/-- The tree shape language `L_E^tree`, generated by `Z → □ | ω Z^{r(ω)}`. -/
inductive TreeShape : Shape.{u} E → Prop
  | blank : TreeShape [Sum.inl PUnit.unit]
  | node (ω : E) (ss : Fin (r ω) → Shape.{u} E) (h : ∀ i, TreeShape (ss i)) :
      TreeShape (Sum.inr ω :: (List.ofFn ss).flatten)

section helpers

variable {A B : Type u}

lemma wordMap_flatten (f : A → B) (l : List (Word A E)) :
    wordMap f l.flatten = (l.map (wordMap f)).flatten := by
  simp [wordMap, List.map_flatten]

lemma shape_flatten (l : List (Word A E)) :
    shape l.flatten = (l.map shape).flatten :=
  wordMap_flatten _ l

/-- A word whose shape is a concatenation splits accordingly. -/
lemma exists_split_of_shape_eq_append (w : Word A E) (s₁ s₂ : Shape.{u} E)
    (h : shape w = s₁ ++ s₂) :
    ∃ w₁ w₂, w = w₁ ++ w₂ ∧ shape w₁ = s₁ ∧ shape w₂ = s₂ := by
  simp only [shape, wordMap] at h
  obtain ⟨w₁, w₂, rfl, h₁, h₂⟩ := List.map_eq_append_iff.mp h
  exact ⟨w₁, w₂, rfl, h₁, h₂⟩

end helpers

/-- **Proposition 5.9** (naturality): `pre_B ∘ T_E(f) = F_E(f) ∘ pre_A`. -/
theorem RankedTerm.prefixWord_map {A B : Type u} (f : A → B) (t : RankedTerm r A) :
    (t.map f).prefixWord = wordMap f t.prefixWord := by
  induction t with
  | leaf a => rfl
  | node ω ts ih =>
    simp only [RankedTerm.map, RankedTerm.prefixWord, wordMap_cons, Sum.map_inr, id_eq,
      wordMap_flatten, List.map_ofFn, Function.comp_def, ih]

/-- Prefix words have tree shapes. -/
theorem RankedTerm.treeShape_shape_prefixWord {A : Type u} (t : RankedTerm r A) :
    TreeShape (r := r) (shape t.prefixWord) := by
  induction t with
  | leaf a => exact TreeShape.blank
  | node ω ts ih =>
    simp only [RankedTerm.prefixWord, shape_cons_inr, shape_flatten, List.map_ofFn,
      Function.comp_def]
    exact TreeShape.node ω _ ih

/-- Prefix-freeness: a prefix word followed by anything determines the term and the rest. -/
theorem RankedTerm.prefixWord_append_inj {A : Type u} :
    ∀ (t t' : RankedTerm r A) (u u' : Word A E),
      t.prefixWord ++ u = t'.prefixWord ++ u' → t = t' ∧ u = u'
  | .leaf a, .leaf a', u, u', h => by
    simp only [RankedTerm.prefixWord, List.singleton_append, List.cons.injEq,
      Sum.inl.injEq] at h
    exact ⟨by rw [h.1], h.2⟩
  | .leaf a, .node ω' ts', u, u', h => by
    simp [RankedTerm.prefixWord] at h
  | .node ω ts, .leaf a', u, u', h => by
    simp [RankedTerm.prefixWord] at h
  | .node ω ts, .node ω' ts', u, u', h => by
    simp only [RankedTerm.prefixWord, List.cons_append, List.cons.injEq, Sum.inr.injEq] at h
    obtain ⟨rfl, h⟩ := h
    suffices key : ∀ (n : ℕ) (ts ts' : Fin n → RankedTerm r A)
        (_ : ∀ i (t' : RankedTerm r A) u u',
          (ts i).prefixWord ++ u = t'.prefixWord ++ u' → ts i = t' ∧ u = u')
        (u u' : Word A E),
        (List.ofFn fun i => (ts i).prefixWord).flatten ++ u =
          (List.ofFn fun i => (ts' i).prefixWord).flatten ++ u' → ts = ts' ∧ u = u' by
      obtain ⟨h₁, h₂⟩ := key (r ω) ts ts'
        (fun i t' u u' => RankedTerm.prefixWord_append_inj (ts i) t' u u') u u' h
      exact ⟨by rw [h₁], h₂⟩
    intro n
    induction n with
    | zero =>
      intro ts ts' _ u u' h
      simp only [List.ofFn_zero, List.flatten_nil, List.nil_append] at h
      exact ⟨funext fun i => i.elim0, h⟩
    | succ n ihn =>
      intro ts ts' ih u u' h
      simp only [List.ofFn_succ, List.flatten_cons, List.append_assoc] at h
      obtain ⟨h₀, h⟩ := ih 0 (ts' 0) _ _ h
      obtain ⟨h₁, h₂⟩ := ihn (fun i => ts i.succ) (fun i => ts' i.succ)
        (fun i => ih i.succ) u u' h
      refine ⟨funext fun i => ?_, h₂⟩
      refine Fin.cases h₀ (fun j => ?_) i
      exact congrFun h₁ j

/-- Every word with a tree shape is a prefix word. -/
theorem RankedTerm.exists_prefixWord_eq {A : Type u} :
    ∀ (s : Shape.{u} E), TreeShape (r := r) s → ∀ w : Word A E, shape w = s →
      ∃ t : RankedTerm r A, t.prefixWord = w := by
  intro s hs
  induction hs with
  | blank =>
    intro w hw
    rcases w with _ | ⟨x | e, w⟩
    · simp at hw
    · simp only [shape_cons_inl, List.cons.injEq, true_and] at hw
      obtain rfl : w = [] := by simpa [shape, wordMap] using hw
      exact ⟨.leaf x, rfl⟩
    · simp at hw
  | node ω ss _ ih =>
    intro w hw
    rcases w with _ | ⟨x | e, w⟩
    · simp at hw
    · simp at hw
    · simp only [shape_cons_inr, List.cons.injEq, Sum.inr.injEq] at hw
      obtain ⟨rfl, hw⟩ := hw
      suffices key : ∀ (n : ℕ) (ss : Fin n → Shape.{u} E)
          (_ : ∀ i (w : Word A E), shape w = ss i → ∃ t : RankedTerm r A, t.prefixWord = w)
          (w : Word A E), shape w = (List.ofFn ss).flatten →
          ∃ ts : Fin n → RankedTerm r A, (List.ofFn fun i => (ts i).prefixWord).flatten = w by
        obtain ⟨ts, hts⟩ := key (r e) ss ih w hw
        exact ⟨.node e ts, by rw [RankedTerm.prefixWord, hts]⟩
      intro n
      induction n with
      | zero =>
        intro ss _ w hw
        simp only [List.ofFn_zero, List.flatten_nil] at hw
        obtain rfl : w = [] := by simpa [shape, wordMap] using hw
        exact ⟨Fin.elim0, by simp⟩
      | succ n ihn =>
        intro ss ih w hw
        simp only [List.ofFn_succ, List.flatten_cons] at hw
        obtain ⟨w₁, w₂, rfl, h₁, h₂⟩ := exists_split_of_shape_eq_append w _ _ hw
        obtain ⟨t₀, ht₀⟩ := ih 0 w₁ h₁
        obtain ⟨ts, hts⟩ := ihn (fun i => ss i.succ) (fun i => ih i.succ) w₂ h₂
        refine ⟨Fin.cons t₀ ts, ?_⟩
        simp only [List.ofFn_succ, Fin.cons_zero, Fin.cons_succ, List.flatten_cons, ht₀, hts]

/-- **Proposition 5.9** (bijection): prefix serialization is a bijection onto the words with
tree shapes. -/
noncomputable def RankedTerm.prefixEquiv (A : Type u) :
    RankedTerm r A ≃ {w : Word A E // TreeShape (r := r) (shape w)} :=
  Equiv.ofBijective (fun t => ⟨t.prefixWord, t.treeShape_shape_prefixWord⟩)
    ⟨fun t t' h =>
      (RankedTerm.prefixWord_append_inj t t' [] [] (by
        simpa using congrArg Subtype.val h)).1,
     fun ⟨w, hw⟩ => by
      obtain ⟨t, ht⟩ := RankedTerm.exists_prefixWord_eq _ hw w rfl
      exact ⟨t, Subtype.ext ht⟩⟩

/-! ### Example 5.10 -/

section binary

/-- Binary tree shapes have one more blank than internal nodes. -/
lemma TreeShape.blanks_eq_count_succ (s : Shape.{u} Unit)
    (hs : TreeShape (r := fun _ : Unit => 2) s) :
    blanks s = s.count (Sum.inr ()) + 1 := by
  induction hs with
  | blank => simp
  | node ω ss _ ih =>
    have h0 := ih 0
    have h1 := ih 1
    simp only [List.ofFn_succ, List.ofFn_zero, List.flatten_cons, List.flatten_nil,
      List.append_nil, blanks_append, List.count_cons_self, List.count_append]
    simp only [Fin.succ_zero_eq_one] at h1 ⊢
    omega

lemma blanks_replicate_inl (n : ℕ) :
    blanks (List.replicate n (Sum.inl PUnit.unit) : Shape.{u} Unit) = n := by
  induction n with
  | zero => rfl
  | succ n ih => simp [List.replicate_succ, ih]

lemma blanks_replicate_inr (n : ℕ) :
    blanks (List.replicate n (Sum.inr ()) : Shape.{u} Unit) = 0 := by
  induction n with
  | zero => rfl
  | succ n ih => simp [List.replicate_succ, ih]

lemma treeShape_replicate (n : ℕ) :
    TreeShape (r := fun _ : Unit => 2)
      (List.replicate n (Sum.inr ()) ++ List.replicate (n + 1) (Sum.inl PUnit.unit) :
        Shape.{u} Unit) := by
  induction n with
  | zero => exact TreeShape.blank
  | succ n ih =>
    have := TreeShape.node (r := fun _ : Unit => 2) ()
      ![List.replicate n (Sum.inr ()) ++ List.replicate (n + 1) (Sum.inl PUnit.unit),
        [Sum.inl PUnit.unit]]
      (by
        intro i
        fin_cases i
        · exact ih
        · exact TreeShape.blank)
    simp only [List.ofFn_succ, List.ofFn_zero, Matrix.cons_val_zero, Fin.succ_zero_eq_one,
      Matrix.cons_val_one, List.flatten_cons, List.flatten_nil,
      List.append_nil] at this
    rw [List.replicate_succ' (n := n + 1), List.replicate_succ, List.cons_append,
      ← List.append_assoc]
    exact this

/-- **Example 5.10**: with one binary constructor, the shape language is not regular; its
intersection with `β^* □^*` is `{βⁿ □ⁿ⁺¹}`. -/
theorem binaryTreeShape_not_regular :
    ¬ (show Language (PUnit ⊕ Unit) from {s | TreeShape (r := fun _ : Unit => 2) s}).IsRegular := by
  intro hreg
  set L : Language (PUnit ⊕ Unit) := {s | TreeShape (r := fun _ : Unit => 2) s} with hL
  rw [Language.isRegular_iff_finite_range_leftQuotient] at hreg
  have := hreg.to_subtype
  let f : ℕ → Set.range L.leftQuotient := fun n =>
    ⟨L.leftQuotient (List.replicate n (Sum.inr ())), ⟨_, rfl⟩⟩
  have hf : Function.Injective f := by
    intro n m hnm
    have h : L.leftQuotient (List.replicate n (Sum.inr ())) =
        L.leftQuotient (List.replicate m (Sum.inr ())) := congrArg Subtype.val hnm
    have hn : List.replicate (n + 1) (Sum.inl PUnit.unit) ∈
        L.leftQuotient (List.replicate n (Sum.inr ())) := by
      show _ ∈ L
      exact treeShape_replicate n
    rw [h] at hn
    have hm : TreeShape (r := fun _ : Unit => 2)
        (List.replicate m (Sum.inr ()) ++ List.replicate (n + 1) (Sum.inl PUnit.unit)) := hn
    have := TreeShape.blanks_eq_count_succ _ hm
    simp only [blanks_append, blanks_replicate_inl, blanks_replicate_inr, List.count_append,
      List.count_replicate] at this
    simpa using this
  have := Finite.of_injective f hf
  exact not_finite ℕ

end binary

/-! ### Closure properties of regular languages (via Myhill–Nerode) -/

section closure

variable {α : Type*}

/-- Finite languages are regular. -/
theorem isRegular_of_finite {L : Language α} (h : (L : Set (List α)).Finite) : L.IsRegular := by
  rw [Language.isRegular_iff_finite_range_leftQuotient]
  let S : Set (List α) := {y | ∃ x, x ++ y ∈ L}
  have hS : S.Finite := by
    refine Set.Finite.subset (h.biUnion fun w _ => (w.tails.finite_toSet)) ?_
    rintro y ⟨x, hx⟩
    exact Set.mem_biUnion hx ((List.mem_tails _ _).mpr ⟨x, rfl⟩)
  refine Set.Finite.subset (hS.finite_subsets) ?_
  rintro _ ⟨x, rfl⟩
  intro y hy
  exact ⟨x, hy⟩

/-- Regular languages are closed under concatenation. -/
theorem isRegular_mul {L₁ L₂ : Language α} (h₁ : L₁.IsRegular) (h₂ : L₂.IsRegular) :
    (L₁ * L₂).IsRegular := by
  rw [Language.isRegular_iff_finite_range_leftQuotient] at h₁ h₂ ⊢
  let F : Language α × Set (Language α) → Language α := fun p => p.1 * L₂ + sSup p.2
  refine Set.Finite.subset ((h₁.prod h₂.finite_subsets).image F) ?_
  rintro _ ⟨x, rfl⟩
  refine ⟨(L₁.leftQuotient x, L₂.leftQuotient '' {v | ∃ a ∈ L₁, a ++ v = x}),
    ⟨⟨x, rfl⟩, Set.image_subset_range _ _⟩, ?_⟩
  ext y
  show y ∈ L₁.leftQuotient x * L₂ + sSup (L₂.leftQuotient '' {v | ∃ a ∈ L₁, a ++ v = x}) ↔
    x ++ y ∈ L₁ * L₂
  rw [Language.mem_add, Language.mem_mul, Language.mem_mul, sSup_image]
  simp only [Language.mem_iSup]
  constructor
  · rintro (⟨a, ha, b, hb, rfl⟩ | ⟨v, ⟨a, ha, rfl⟩, hv⟩)
    · exact ⟨x ++ a, ha, b, hb, by simp⟩
    · exact ⟨a, ha, v ++ y, hv, by simp⟩
  · rintro ⟨a, ha, b, hb, hab⟩
    rcases List.append_eq_append_iff.mp hab with ⟨a', rfl, rfl⟩ | ⟨c', rfl, rfl⟩
    · exact Or.inr ⟨a', ⟨a, ha, rfl⟩, hb⟩
    · exact Or.inl ⟨c', ha, b, hb, rfl⟩

/-- Regular languages are closed under Kleene star. -/
theorem isRegular_kstar {L : Language α} (h : L.IsRegular) : (L∗).IsRegular := by
  classical
  rw [Language.isRegular_iff_finite_range_leftQuotient] at h ⊢
  let F : Language α × Set (Language α) → Language α := fun p => p.1 + sSup p.2
  have hfin : (({⊥, L∗} : Set (Language α)) ×ˢ
      {S | S ⊆ (fun Q => Q * L∗) '' Set.range L.leftQuotient}).Finite :=
    (Set.toFinite _).prod (h.image _).finite_subsets
  refine Set.Finite.subset (hfin.image F) ?_
  rintro _ ⟨x, rfl⟩
  refine ⟨(if x ∈ L∗ then L∗ else ⊥,
      (fun v => L.leftQuotient v * L∗) '' {v | ∃ u ∈ L∗, u ++ v = x}), ⟨?_, ?_⟩, ?_⟩
  · split_ifs
    · exact Or.inr rfl
    · exact Or.inl rfl
  · rintro _ ⟨v, _, rfl⟩
    exact ⟨L.leftQuotient v, ⟨v, rfl⟩, rfl⟩
  · have hle : ∀ w, w ∈ L * L∗ → w ∈ L∗ := fun w hw =>
      (Language.le_iff _ _).mp (mul_kstar_le_kstar (a := L)) ▸ (Language.mem_add _ _ w).mpr (Or.inl hw)
    ext y
    show y ∈ (if x ∈ L∗ then L∗ else ⊥) +
        sSup ((fun v => L.leftQuotient v * L∗) '' {v | ∃ u ∈ L∗, u ++ v = x}) ↔ x ++ y ∈ L∗
    rw [Language.mem_add, sSup_image]
    simp only [Language.mem_iSup]
    symm
    constructor
    · intro hxy
      obtain ⟨S, hS, hmem⟩ := Language.mem_kstar.mp hxy
      rcases List.flatten_eq_append_iff.mp hS.symm with
        ⟨as, bs, rfl, rfl, rfl⟩ | ⟨as, bs, c, cs, ds, rfl, rfl, rfl⟩
      · left
        have hx : as.flatten ∈ L∗ :=
          Language.mem_kstar.mpr ⟨as, rfl, fun y hy => hmem y (by simp [hy])⟩
        rw [ite_eq_left hx]
        exact Language.mem_kstar.mpr ⟨bs, rfl, fun y hy => hmem y (by simp [hy])⟩
      · right
        refine ⟨bs, ⟨as.flatten,
          Language.mem_kstar.mpr ⟨as, rfl, fun y hy => hmem y (by simp [hy])⟩, rfl⟩, ?_⟩
        refine Language.append_mem_mul (m := L∗) ?_
          (Language.mem_kstar.mpr ⟨ds, rfl, fun y hy => hmem y (by simp [hy])⟩)
        show bs ++ (c :: cs) ∈ L
        exact hmem _ (by simp)
    · rintro (hy | ⟨v, ⟨u, hu, rfl⟩, hv⟩)
      · split_ifs at hy with hx
        · have : x ++ y ∈ L∗ * L∗ := Language.append_mem_mul hx hy
          rwa [kstar_mul_kstar] at this
        · exact absurd hy (Set.notMem_empty y)
      · obtain ⟨d, hd, e, he, rfl⟩ := Language.mem_mul.mp hv
        have h2 : (v ++ d) ++ e ∈ L∗ := hle _ (Language.append_mem_mul hd he)
        have h3 : u ++ ((v ++ d) ++ e) ∈ L∗ * L∗ := Language.append_mem_mul hu h2
        rw [kstar_mul_kstar] at h3
        simpa only [List.append_assoc] using h3

end closure

/-- The regular protocol format `(usr □^* end asst □^* end)^*` (§5.8). -/
def protocolShapes (usr asst «end» : E) : Language (PUnit.{u+1} ⊕ E) :=
  KStar.kstar (({[Sum.inr usr]} : Language (PUnit.{u+1} ⊕ E)) *
    KStar.kstar ({[Sum.inl PUnit.unit]} : Language (PUnit.{u+1} ⊕ E)) *
    {[Sum.inr «end»]} * {[Sum.inr asst]} *
    KStar.kstar ({[Sum.inl PUnit.unit]} : Language (PUnit.{u+1} ⊕ E)) * {[Sum.inr «end»]})

theorem protocolShapes_isRegular (usr asst «end» : E) : (protocolShapes.{u} usr asst «end»).IsRegular := by
  have hs : ∀ x : PUnit.{u+1} ⊕ E, ({[x]} : Language (PUnit.{u+1} ⊕ E)).IsRegular :=
    fun x => isRegular_of_finite (Set.finite_singleton _)
  exact isRegular_kstar (isRegular_mul (isRegular_mul (isRegular_mul (isRegular_mul
    (isRegular_mul (hs _) (isRegular_kstar (hs _))) (hs _)) (hs _)) (isRegular_kstar (hs _)))
    (hs _))

end AT
